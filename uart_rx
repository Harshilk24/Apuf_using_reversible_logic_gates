module uart_Rx#(
parameter CLK_FREQ = 100_000_000,
parameter BAUD_RATE = 115200
)(
input wire clk,
input wire rst,
input wire rx,

output reg[7:0] data_out,
output reg rx_done
);
localparam integer BAUD_COUNT= CLK_FREQ/BAUD_RATE;

reg rx_sync1;
reg rx_sync2;

reg [1:0] state;
localparam  IDLE  = 2'd0;
localparam  START = 2'd1;
localparam  DATA  = 2'd2;
localparam  STOP  = 2'd3;

reg[15:0] baud_counter;
reg[3:0] bit_counter;

reg[7:0] rx_data;

always@(posedge clk) begin
if (rst) begin
rx_sync1<=1'b1;
rx_sync2 <= 1'b1;

state<= IDLE;
baud_counter<=16'd0;
bit_counter<= 16'd0;

rx_data <= 8'd0;
data_out <= 8'd0;
rx_done <= 1'b0;
end
else begin
rx_sync1 <=rx;
rx_sync2<= rx_sync1;

rx_done<=1'b0;
case(state)

IDLE:begin
baud_counter<=16'd0;
bit_counter<= 16'd0;

if (rx_sync2==1'b0)begin
state<=START;
end
end

START:begin
if (baud_counter==(BAUD_COUNT/2)-1)begin
baud_counter=16'd0;
  if(rx_sync2==1'b0)begin
     state<=DATA;
     end
     else begin
     state<=IDLE;
     end
     end
   else begin
     baud_counter=baud_counter +1'b1;
     end
   end
DATA:begin
 
if(baud_counter==BAUD_COUNT - 1)begin
baud_counter<=16'd0;
rx_data[bit_counter]<=rx_sync2;

if (bit_counter==4'd7)begin
state<=STOP;
end
else begin
bit_counter=bit_counter+1'b1;
end 
end
else begin 
baud_counter=baud_counter+ 1'b1;
end 
end

STOP:begin
 
 if(baud_counter==BAUD_COUNT-1) begin
 baud_counter<=16'd0;
 if(rx_sync2==1'b1) begin
 data_out<=rx_data;
 rx_done<=1'b1;

end
state<=IDLE;
end
else begin 
baud_counter=baud_counter+1'b1;
end
end 
default:begin 
state<=IDLE;
end
endcase
end
end
endmodul
