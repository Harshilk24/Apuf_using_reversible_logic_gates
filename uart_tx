timescale 1ns / 1ps


module uart_tx #(
parameter CLK_FREQ = 100_000_000,
parameter BAUD_RATE = 115200
    )(
    input wire  clk,                                  
    input wire rst,
    input wire [7:0] data_in,
    input wire tx_start,
    
    output reg tx,
    output reg tx_busy
    );
    localparam integer BAUD_COUNT= CLK_FREQ/BAUD_RATE;
    reg [15:0] baud_counter;
    reg [3:0] bit_counter;
    reg [9:0] tx_shift;
    
    always @(posedge clk) begin
    if (rst) begin
    tx <= 1'b1;
    tx_busy <= 1'b0;
    baud_counter <=16'd0;
    bit_counter <=4'd0;
    tx_shift <=10'b1111111111;
    end
    else begin
    if (tx_start && !tx_busy) begin
     tx_shift <={1'b1,data_in,1'b0};
     tx_busy<=1'b1;
    baud_counter<=16'd0;
    bit_counter<=4'd0;
    tx<=1'b0;
    end
    else if (tx_busy) begin
    if(baud_counter==BAUD_COUNT-1)begin
    baud_counter<=16'd0;
    if(bit_counter == 4'd9)begin
    tx_busy<=1'b0;
    tx<=1'b1;
    end
    else begin
    bit_counter<=bit_counter + 1'b1;
    tx_shift <= {1'b1,tx_shift[9:1] };
    tx<=tx_shift[1];
    end
    end
    else begin
    baud_counter<=baud_counter + 1'b1;
    end
    end
    end
    end 
endmodule
